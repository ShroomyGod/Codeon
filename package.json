{
  "name": "codeon",
  "productName": "Codeon",
  "version": "1.1.2",
  "description": "Codeon — an AI copilot for Roblox Studio. Attach to a live Studio instance, chat with free OpenCode Zen models or bring your own provider key, review every change as a diff, edit code and properties, and run playtests without leaving the app.",
  "main": "./out/main/index.js",
  "author": {
    "name": "ShroomyGod",
    "url": "https://github.com/ShroomyGod"
  },
  "license": "SEE LICENSE IN LICENSE — non-commercial, share-alike, attribution required",
  "homepage": "https://github.com/ShroomyGod/Codeon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShroomyGod/Codeon.git"
  },
  "bugs": {
    "url": "https://github.com/ShroomyGod/Codeon/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:core": "node scripts/build-core.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --import tsx --test tests/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/make-icons.mjs",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --bump patch",
    "release:minor": "node scripts/release.mjs --bump minor",
    "services": "node scripts/generate-service-classes.mjs"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "diff": "^9.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jimp": "^1.6.1",
    "lucide-react": "^1.54.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
